# Standardize line endings to LF across all platforms
* text=auto eol=lf

# Explicit LF for code and configuration files
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Windows command batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - prevent any line ending transformation
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
